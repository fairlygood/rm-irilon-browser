maintainer="fairlygood <irilonbrowser@fairlygood.net>"
pkgname=irilon
pkgver=1.0.0
pkgrel=0
upstream_author="fairlygood"
category="apps"
pkgdesc="Gemini protocol browser for reMarkable tablets"
url="https://github.com/fairlygood/rm-irilon-browser"
arch="aarch64 armv7"
license="MIT"
depends="appload !rm1"
readmeurl="https://raw.githubusercontent.com/$upstream_author/rm-irilon-browser/v$pkgver/README.md"

source="
https://github.com/$upstream_author/rm-irilon-browser/releases/download/v$pkgver/irilon-$pkgver-arm64.zip
https://github.com/$upstream_author/rm-irilon-browser/releases/download/v$pkgver/irilon-$pkgver-armv7.zip
https://raw.githubusercontent.com/$upstream_author/rm-irilon-browser/v$pkgver/LICENSE
"

unpack() {
	case "$CARCH" in
	aarch64) archive="$srcdir/irilon-$pkgver-arm64.zip" ;;
	armv7) archive="$srcdir/irilon-$pkgver-armv7.zip" ;;
	esac
	unzip -q -o "$archive" -d "$srcdir/_unpacked"
	mkdir -p "$srcdir/app"
	cp -a "$srcdir"/_unpacked/irilon-*/. "$srcdir/app/"
}

package() {
	install -Dm644 "$srcdir/app/manifest.json" \
		"$pkgdir"/home/root/xovi/exthome/appload/irilon/manifest.json
	install -Dm644 "$srcdir/app/resources.rcc" \
		"$pkgdir"/home/root/xovi/exthome/appload/irilon/resources.rcc
	install -Dm644 "$srcdir/app/icon.png" \
		"$pkgdir"/home/root/xovi/exthome/appload/irilon/icon.png
	install -Dm755 "$srcdir/app/backend/entry" \
		"$pkgdir"/home/root/xovi/exthome/appload/irilon/backend/entry

	install -Dm644 "$srcdir/LICENSE" \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/$upstream_author/rm-irilon-browser/archive/v$pkgver.tar.gz" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

predeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -f /home/root/.irilon-settings.json
		rm -f /home/root/.gemini-certificates.json
	fi
}

